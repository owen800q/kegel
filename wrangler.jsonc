{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "core-timer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only the push API runs the Worker; everything else is served as static assets.
    "run_worker_first": ["/api/*"]
  },
  // Push subscriptions and reminder times only. No database_id: Wrangler
  // provisions the database on first deploy; the Worker creates its table.
  "d1_databases": [{ "binding": "DB", "database_name": "core-timer-push" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "VAPID_SUBJECT": "https://kegel.codeboxhk.com" },
  // Secrets (set with `npx wrangler secret put …`, see README):
  //   VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY  (generate with `npm run vapid`)
  "observability": { "enabled": true }
}
